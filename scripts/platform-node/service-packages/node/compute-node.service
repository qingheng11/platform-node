[Unit]
Description=Compute local GPU model service

[Service]
Type=simple
UMask=0077
Environment=XDG_CONFIG_HOME=%h/.config/compute-node-service
Environment=COMPUTE_NODE_DATA_DIR=%h/.local/state/compute-node
EnvironmentFile=-%h/.config/compute-node-service/service.env
ExecStart=%h/.local/lib/compute-node/compute-node serve --data-dir ${COMPUTE_NODE_DATA_DIR}
KillMode=mixed
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
